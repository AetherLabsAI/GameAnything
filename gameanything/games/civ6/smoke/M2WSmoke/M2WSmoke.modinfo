<?xml version="1.0" encoding="utf-8"?>
<!-- GameAnything smoke mod for Civilization VI: proves build -> install -> load -> visible effect, with text only.
     Front end (main menu): UpdateText marks the existing "Exit to Desktop" button.
     In game: UpdateText marks the World Tracker's "Choose Research" label; a gameplay script logs one line.
     Text goes through UpdateText actions (as the game's own DLC do); a top-level <LocalizedText> in a .modinfo only names the mod.
     It changes no rules and does not affect saves. -->
<Mod id="9707163e-1706-47cf-a4e6-fbd180b40f10" version="2">
  <Properties>
    <Name>M2W Smoke</Name>
    <Description>GameAnything smoke test: two marked labels (main menu, World Tracker) and a log line. Changes nothing else.</Description>
    <Teaser>GameAnything smoke test</Teaser>
    <Authors>GameAnything</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <FrontEndActions>
    <UpdateText id="M2WSmokeFrontEndText">
      <File>Text/M2WSmoke_FrontEnd.xml</File>
    </UpdateText>
  </FrontEndActions>
  <InGameActions>
    <UpdateText id="M2WSmokeText">
      <File>Text/M2WSmoke_Text.xml</File>
    </UpdateText>
    <AddGameplayScripts id="M2WSmokeGameplay">
      <File>Scripts/M2WSmokeGameplay.lua</File>
    </AddGameplayScripts>
  </InGameActions>
  <Files>
    <File>Scripts/M2WSmokeGameplay.lua</File>
    <File>Text/M2WSmoke_FrontEnd.xml</File>
    <File>Text/M2WSmoke_Text.xml</File>
  </Files>
</Mod>
